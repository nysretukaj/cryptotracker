<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listFragment"> <fragment
    android:id="@+id/listFragment"
    android:name="com.example.cryptotracker.ListFragment"
    android:label="Crypto List"
    tools:layout="@layout/fragment_list">

    <action
        android:id="@+id/action_listFragment_to_detailFragment"
        app:destination="@id/detailFragment" />
</fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.cryptotracker.DetailFragment"
        android:label="DetailFragment">

        <argument
            android:name="cryptoName"
            app:argType="string" />
        <argument
            android:name="cryptoSymbol"
            app:argType="string" />
        <argument
            android:name="cryptoPrice"
            app:argType="string" />
        <argument
            android:name="cryptoImage"
            app:argType="string" />
    </fragment>

</navigation>